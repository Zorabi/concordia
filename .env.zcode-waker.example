# Legacy headless mode. Desktop users should run /worker in ZCode instead.
CONCORDIA_TRANSPORT=stdio
# Optional: override the shared state directory (default ~/.concordia).
# CONCORDIA_HOME=/absolute/path/to/concordia-home
# Optional hardening: restrict accessible Git roots.
# CONCORDIA_CONFIG_FILE=/absolute/path/to/concordia.config.json
# Optional: default 5000; use 0 to fail closed immediately after a read failure.
# CONCORDIA_CONFIG_STALE_GRACE_MS=5000
# Backward-compatible fallback when CONCORDIA_CONFIG_FILE is not set.
# CONCORDIA_ROOTS=/absolute/path/to/example-app
# CONCORDIA_DB=/absolute/path/to/state.db
# CONCORDIA_ZCODE_WAKER_DB=/absolute/path/to/zcode-waker.db

# Optional ZCode CLI overrides.
# CONCORDIA_ZCODE_BIN=/absolute/path/to/zcode
# CONCORDIA_ZCODE_MODE=build
# Optional: only enable when the installed ZCode CLI accepts --max-turns.
# CONCORDIA_ZCODE_MAX_TURNS=100
# CONCORDIA_ZCODE_TURN_TIMEOUT_MS=3600000
# CONCORDIA_ZCODE_MAX_OUTPUT_BYTES=4194304
# CONCORDIA_ZCODE_ENV_ALLOWLIST=HTTPS_PROXY,NO_PROXY
# CONCORDIA_ZCODE_WAKER_POLL_TIMEOUT_MS=60000
# CONCORDIA_ZCODE_WAKER_RETRY_DELAY_MS=5000
# CONCORDIA_ZCODE_WAKER_MAX_RETRY_DELAY_MS=300000

# Redis mode replaces CONCORDIA_CONFIG_FILE/CONCORDIA_ROOTS and CONCORDIA_DB with these values.
# CONCORDIA_TRANSPORT=redis
# CONCORDIA_REDIS_URL=rediss://user:password@redis.example.com:6379/0
# CONCORDIA_RELAY_NAMESPACE=team-a
# CONCORDIA_RELAY_ZCODE_TOKEN=replace-with-at-least-32-random-characters
