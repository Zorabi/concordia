# Local mode. State defaults to ~/.concordia for the current user.
CONCORDIA_TRANSPORT=stdio
# Optional: override the shared state directory.
# CONCORDIA_HOME=/absolute/path/to/concordia-home
# Optional hardening: restrict accessible Git roots. Keep this file private.
# CONCORDIA_CONFIG_FILE=/absolute/path/to/concordia.config.json
# Optional: default 5000; use 0 to fail closed immediately after a read failure.
# CONCORDIA_CONFIG_STALE_GRACE_MS=5000
# Backward-compatible fallback when CONCORDIA_CONFIG_FILE is not set.
# CONCORDIA_ROOTS=/absolute/path/to/example-app
# CONCORDIA_DB=/absolute/path/to/state.db
# CONCORDIA_WAKER_DB=/absolute/path/to/codex-waker.db
# CONCORDIA_WAKER_CWD=/absolute/path/to/review-workspace

# Optional Codex App Server overrides.
# CONCORDIA_CODEX_BIN=/absolute/path/to/codex
# CONCORDIA_WAKER_MODEL=gpt-5.6-terra
# CONCORDIA_WAKER_EFFORT=medium
# CONCORDIA_WAKER_POLL_TIMEOUT_MS=60000
# CONCORDIA_WAKER_REQUEST_TIMEOUT_MS=30000
# CONCORDIA_WAKER_TURN_TIMEOUT_MS=1800000
# CONCORDIA_WAKER_RETRY_DELAY_MS=5000
# CONCORDIA_WAKER_MAX_RETRY_DELAY_MS=300000

# Redis mode replaces CONCORDIA_CONFIG_FILE/CONCORDIA_ROOTS and CONCORDIA_DB with these values.
# CONCORDIA_TRANSPORT=redis
# CONCORDIA_REDIS_URL=rediss://user:password@redis.example.com:6379/0
# CONCORDIA_RELAY_NAMESPACE=team-a
# CONCORDIA_RELAY_CODEX_TOKEN=replace-with-at-least-32-random-characters
