# Redis relay settings shared by the coordinator and MCP relay clients.
# Use a managed Redis endpoint with TLS when crossing machines.
CONCORDIA_REDIS_URL=rediss://concordia-user:replace-password@redis.example.com:6379/0
CONCORDIA_RELAY_NAMESPACE=concordia-production

# Generate two different values with: openssl rand -hex 32
CONCORDIA_RELAY_CODEX_TOKEN=replace-with-at-least-32-random-characters
CONCORDIA_RELAY_ZCODE_TOKEN=replace-with-another-32-random-characters

# Only MCP clients set this. Omit it on the coordinator process.
CONCORDIA_TRANSPORT=redis

# Coordinator-local paths. These paths must exist on the ZCode/Git machine.
CONCORDIA_DB=/absolute/path/on-zcode-host/concordia.db
# Preferred: shared JSON file read for every coordinator request.
CONCORDIA_CONFIG_FILE=/absolute/path/on-zcode-host/concordia.config.json
# Optional: default 5000; use 0 to fail closed immediately after a read failure.
# CONCORDIA_CONFIG_STALE_GRACE_MS=5000
# Backward-compatible fallback when CONCORDIA_CONFIG_FILE is not set.
# CONCORDIA_ROOTS=/absolute/path/on-zcode-host/repositories

# Optional tuning.
CONCORDIA_RELAY_REQUEST_TIMEOUT_MS=75000
CONCORDIA_RELAY_MAX_INFLIGHT=16
CONCORDIA_RELAY_MAX_MESSAGE_BYTES=1048576
CONCORDIA_RELAY_CLOCK_SKEW_MS=60000
CONCORDIA_RELAY_RESPONSE_TTL_SECONDS=300
CONCORDIA_RELAY_NONCE_TTL_SECONDS=300
CONCORDIA_RELAY_PENDING_IDLE_MS=120000

# Development only: permits redis:// to a non-loopback address.
# CONCORDIA_RELAY_ALLOW_INSECURE=true
