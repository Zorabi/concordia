{
  "name": "concordia",
  "version": "0.4.0",
  "private": true,
  "license": "MIT",
  "description": "Local-first MCP coordination runtime for Codex and ZCode with an optional Redis relay",
  "type": "module",
  "main": "dist/src/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json && npm run build:plugin",
    "build:plugin": "esbuild src/index.ts --bundle --platform=node --format=esm --target=node22.13 --outfile=zcode-plugin/dist/index.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test dist/tests/*.test.js",
    "start": "node dist/src/index.js",
    "start:relay": "node dist/src/relay.js",
    "start:waker": "node dist/src/codex-waker.js",
    "start:zcode-waker": "node dist/src/zcode-waker.js"
  },
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@redis/client": "^5.12.1",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.7.0"
  }
}
