{
  "mcpServers": {
    "concordia": {
      "type": "stdio",
      "command": "node",
      "args": ["${CLAUDE_PLUGIN_ROOT}/dist/index.mjs"],
      "cwd": "${CLAUDE_PROJECT_DIR}",
      "env": {
        "CONCORDIA_TRANSPORT": "stdio",
        "CONCORDIA_ROOTS": "${CLAUDE_PROJECT_DIR}",
        "CONCORDIA_DB": "${CLAUDE_PROJECT_DIR}/.concordia/state.db",
        "CONCORDIA_AGENT_ID": "zcode"
      },
      "enabled": true,
      "timeoutMs": 70000
    }
  }
}
